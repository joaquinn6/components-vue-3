{
  "name": "@joaquinn6/jnv-ui-components",
  "version": "0.2.0",
  "description": "Componentes Vue 3 tematizables de JNV.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/styles.css",
    "./themes/jnv.css": "./src/styles/themes/jnv.css",
    "./themes/jnv-light.css": "./src/styles/themes/jnv-light.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles/themes",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaquinn6/components-vue-3.git"
  },
  "bugs": {
    "url": "https://github.com/joaquinn6/components-vue-3/issues"
  },
  "homepage": "https://github.com/joaquinn6/components-vue-3#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite --config vite.playground.config.js",
    "build": "vite build && vue-tsc -p tsconfig.build.json --noCheck",
    "build:playground": "vite build --config vite.playground.config.js",
    "preview:playground": "vite preview --config vite.playground.config.js",
    "check:types": "vue-tsc --noEmit --noCheck",
    "check:playground-types": "vue-tsc --noEmit --noCheck -p tsconfig.playground.json",
    "check:consumer-types": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck scripts/check-types-consumer.ts",
    "format:check": "prettier --check .",
    "check:base-colors": "node scripts/check-base-colors.mjs"
  },
  "peerDependencies": {
    "@vuepic/vue-datepicker": "^14.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@vuepic/vue-datepicker": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vuepic/vue-datepicker": "^14.0.0",
    "prettier": "3.9.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.11"
  }
}
